+static std::string json_unescape(const std::string& raw) {
+    std::string out;
+    out.reserve(raw.size());
+    for (size_t i = 0; i < raw.size(); ++i) {
+        if (raw[i] != '\\' || i + 1 >= raw.size()) {
+            out.push_back(raw[i]);
+            continue;
+        }
+        const char c = raw[++i];
+        if (c == 'n') out.push_back('\n');
+        else if (c == 't') out.push_back('\t');
+        else if (c == 'r') out.push_back('\r');
+        else if (c == 'u' && i + 4 < raw.size()) {
+            int cp = std::stoi(raw.substr(i + 1, 4), nullptr, 16);
+            i += 4;
+            if (cp < 0x80) out.push_back(static_cast<char>(cp));
+            else if (cp < 0x800) {
+                out.push_back(static_cast<char>(0xc0 | (cp >> 6)));
+                out.push_back(static_cast<char>(0x80 | (cp & 0x3f)));
+            } else {
+                out.push_back(static_cast<char>(0xe0 | (cp >> 12)));
+                out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3f)));
+                out.push_back(static_cast<char>(0x80 | (cp & 0x3f)));
+            }
+        } else out.push_back(c);
+    }
+    return out;
+}
+
+static std::string json_string_after(const std::string& line, size_t key_pos) {
+    auto colon = line.find(':', key_pos);
+    if (colon == std::string::npos) return {};
+    auto quote = line.find('"', colon + 1);
+    if (quote == std::string::npos) return {};
+    std::string raw;
+    for (size_t i = quote + 1; i < line.size(); ++i) {
+        if (line[i] == '\\') {
+            raw.push_back('\\');
+            if (i + 1 < line.size()) raw.push_back(line[++i]);
+            continue;
+        }
+        if (line[i] == '"') break;
+        raw.push_back(line[i]);
+    }
+    return json_unescape(raw);
+}
+
+static bool utf8_has_cjk(const std::string& text) {
+    for (size_t i = 0; i < text.size();) {
+        const unsigned char c = static_cast<unsigned char>(text[i]);
+        uint32_t cp = c;
+        size_t n = 1;
+        if ((c & 0xE0) == 0xC0 && i + 1 < text.size()) {
+            cp = ((c & 0x1Fu) << 6) | (static_cast<unsigned char>(text[i + 1]) & 0x3Fu);
+            n = 2;
+        } else if ((c & 0xF0) == 0xE0 && i + 2 < text.size()) {
+            cp = ((c & 0x0Fu) << 12) |
+                 ((static_cast<unsigned char>(text[i + 1]) & 0x3Fu) << 6) |
+                 (static_cast<unsigned char>(text[i + 2]) & 0x3Fu);
+            n = 3;
+        } else if ((c & 0xF8) == 0xF0 && i + 3 < text.size()) {
+            n = 4;
+        } else if (c >= 0x80) {
+            ++i;
+            continue;
+        }
+        if (cp >= 0x4E00 && cp <= 0x9FFF) return true;
+        i += n;
+    }
+    return false;
+}
+
+static std::string rstrip_ws(std::string text) {
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\n' || text.back() == '\r' || text.back() == '\t')) {
+        text.pop_back();
+    }
+    return text;
+}
+
+static bool ends_with(const std::string& text, const std::string& suffix) {
+    return text.size() >= suffix.size() && text.compare(text.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+// Same closing line the desktop client trains and scores with.
+static std::string with_brief(const std::string& user) {
+    const std::string text = rstrip_ws(user);
+    if (utf8_has_cjk(text)) {
+        if (ends_with(text, "请简短回答。")) return text;
+        return text + " 请简短回答。";
+    }
+    if (ends_with(text, "Answer briefly.")) return text;
+    return text + " Answer briefly.";
+}
