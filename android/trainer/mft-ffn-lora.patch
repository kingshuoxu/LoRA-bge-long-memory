+static std::vector<int32_t> greedy_continue(QwenModel& model, std::vector<int32_t> ids, int gen_new, int eos_id) {
+    for (int t = 0; t < gen_new; ++t) {
+        const int64_t S = static_cast<int64_t>(ids.size());
+        auto input = zeros({1, S}, kInt32, kCPU);
+        std::memcpy(input->data<int32_t>(), ids.data(), static_cast<size_t>(S) * sizeof(int32_t));
+        auto attn = zeros({1, S}, kFloat32, kCPU);
+        std::fill(attn->data<float>(), attn->data<float>() + S, 1.0f);
+        auto logits = model.forward(input, attn);
+        const int64_t V = logits->shape()[2];
+        const float* row = logits->data<float>() + (S - 1) * V;
+        int32_t best = 0;
+        float best_v = -1e30f;
+        for (int64_t v = 0; v < V; ++v) {
+            if (row[v] > best_v) { best_v = row[v]; best = static_cast<int32_t>(v); }
+        }
+        ids.push_back(best);
+        logits.reset();
+        input.reset();
+        attn.reset();
+        if (best == eos_id || best == 151645) break;
+        MemoryManager::instance().force_cleanup();
+    }
+    MemoryManager::instance().clear_unused_memory();
+    return ids;
+}
