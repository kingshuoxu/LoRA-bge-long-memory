+static void load_lora_weights_bin(const std::string& path, const std::vector<TensorPtr>& params) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in.is_open()) throw std::runtime_error("failed to open LoRA file: " + path);
+    int32_t num_params = 0;
+    in.read(reinterpret_cast<char*>(&num_params), sizeof(num_params));
+    if (num_params != static_cast<int32_t>(params.size())) {
+        throw std::runtime_error("LoRA param count mismatch");
+    }
+    for (const auto& param : params) {
+        int32_t ndim = 0;
+        in.read(reinterpret_cast<char*>(&ndim), sizeof(ndim));
+        if (ndim != static_cast<int32_t>(param->shape().size())) {
+            throw std::runtime_error("LoRA rank mismatch");
+        }
+        for (int64_t dim : param->shape()) {
+            int64_t got = 0;
+            in.read(reinterpret_cast<char*>(&got), sizeof(got));
+            if (got != dim) throw std::runtime_error("LoRA shape mismatch");
+        }
+        in.read(reinterpret_cast<char*>(param->data<float>()), param->numel() * sizeof(float));
+    }
