+static void gguf_string(std::ostream& out, const std::string& s) {
+    const uint64_t n = s.size();
+    out.write(reinterpret_cast<const char*>(&n), sizeof(n));
+    out.write(s.data(), static_cast<std::streamsize>(n));
+}
