+static int write_fact_ids_jsonl(QwenBPETokenizer& tokenizer, const std::string& facts_path,
+                                const std::string& out_path) {
+    std::ifstream in(facts_path);
+    if (!in.is_open()) throw std::runtime_error("failed to open facts jsonl: " + facts_path);
+    std::ofstream out(out_path);
+    if (!out.is_open()) throw std::runtime_error("failed to write " + out_path);
+    int longest = 0;
+    int rows = 0;
+    std::string line;
+    auto dump = [&](const std::vector<int>& ids, const std::vector<int>& mask) {
+        out << "{\"ids\":[";
+        for (size_t i = 0; i < ids.size(); ++i) {
+            if (i) out << ",";
+            out << ids[i];
+        }
+        out << "],\"mask\":[";
+        for (size_t i = 0; i < mask.size(); ++i) {
+            if (i) out << ",";
+            out << mask[i];
+        }
+        out << "]}\n";
+        longest = std::max(longest, static_cast<int>(ids.size()));
+        ++rows;
+    };
+    while (std::getline(in, line)) {
+        if (line.empty()) continue;
+        auto statement_key = line.find("\"statement\"");
+        if (statement_key == std::string::npos) continue;
+        const std::string statement = json_string_after(line, statement_key);
+        // Desktop AssistantDataset: one chat row that asks the model to state the fact,
+        // then one chat row per confirmed question. Loss stays on the assistant tokens.
+        const std::string instruction = utf8_has_cjk(statement) ? "请说出这条事实。" : "State this fact.";
+        auto add_chat = [&](const std::string& user, const std::string& assistant) {
+            const std::string user_text = with_brief(user);
+            const std::string system = utf8_has_cjk(user_text) ? "你是助手。" : "You are a helpful assistant.";
+            const std::string prompt =
+                "<|im_start|>system\n" + system + "<|im_end|>\n<|im_start|>user\n" +
+                user_text + "<|im_end|>\n<|im_start|>assistant\n";
+            auto p_ids = tokenizer.encode(prompt, false, 0, false);
+            auto a_ids = tokenizer.encode(rstrip_ws(assistant) + "<|im_end|>\n", false, 0, false);
+            std::vector<int> ids = p_ids;
+            ids.insert(ids.end(), a_ids.begin(), a_ids.end());
+            std::vector<int> mask(p_ids.size(), 0);
+            mask.insert(mask.end(), a_ids.size(), 1);
+            dump(ids, mask);
+        };
+        add_chat(instruction, statement);
+        auto qa_pos = line.find("\"qa\"");
+        if (qa_pos == std::string::npos) continue;
+        auto bracket = line.find('[', qa_pos);
+        if (bracket == std::string::npos) continue;
+        size_t cursor = bracket;
+        while (true) {
+            auto qk = line.find("\"q\"", cursor);
+            auto ak = line.find("\"a\"", cursor);
+            if (qk == std::string::npos || ak == std::string::npos) break;
+            if (qk > ak) { cursor = ak + 3; continue; }
+            const std::string q = json_string_after(line, qk);
+            const std::string a = json_string_after(line, ak);
+            add_chat(q, a);
+            cursor = ak + 3;
