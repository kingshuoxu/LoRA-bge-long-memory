+static void save_lora_gguf(const std::string& path, const std::vector<TensorPtr>& params,
+                           int num_layers, float alpha, bool mlp) {
+    if (!mlp || params.size() != static_cast<size_t>(num_layers) * 6) {
+        throw std::runtime_error("GGUF export only supports the FFN gate/up/down recipe");
+    }
+    std::ofstream out(path, std::ios::binary);
+    if (!out.is_open()) throw std::runtime_error("failed to open " + path);
+    const uint32_t magic = 0x46554747u;
+    const uint32_t version = 3;
+    const uint64_t tensor_count = params.size();
+    out.write(reinterpret_cast<const char*>(&magic), 4);
+    out.write(reinterpret_cast<const char*>(&version), 4);
+    out.write(reinterpret_cast<const char*>(&tensor_count), 8);
+
+    struct Kv {
+        std::string key;
+        uint32_t type;
+        std::string str;
+        uint32_t u32 = 0;
+        float f32 = 0;
+    };
+    std::vector<Kv> kvs = {
+        {"general.architecture", 8, "qwen2"},
+        {"general.type", 8, "adapter"},
+        {"adapter.type", 8, "lora"},
+        {"general.name", 8, "mft-expert"},
+        {"adapter.lora.alpha", 6, "", 0, alpha},
+        {"general.quantization_version", 4, "", 2, 0},
+    };
+    const uint64_t kv_count = kvs.size();
+    out.write(reinterpret_cast<const char*>(&kv_count), 8);
+    for (const auto& kv : kvs) {
+        gguf_string(out, kv.key);
+        out.write(reinterpret_cast<const char*>(&kv.type), 4);
+        if (kv.type == 8) gguf_string(out, kv.str);
+        else if (kv.type == 4) out.write(reinterpret_cast<const char*>(&kv.u32), 4);
+        else if (kv.type == 6) out.write(reinterpret_cast<const char*>(&kv.f32), 4);
+    }
+
+    const char* names[] = {"ffn_gate", "ffn_up", "ffn_down"};
+    const uint64_t alignment = 32;
+    std::vector<std::string> tensor_names;
+    std::vector<std::pair<int64_t, int64_t>> ggml_dims;
+    tensor_names.reserve(params.size());
+    size_t cursor = 0;
+    for (int layer = 0; layer < num_layers; ++layer) {
+        for (const char* tgt : names) {
+            for (const char* side : {"lora_a", "lora_b"}) {
+                tensor_names.push_back("blk." + std::to_string(layer) + "." + tgt + ".weight." + side);
+                const auto& shape = params[cursor]->shape();
+                // File stores ggml ne[0], ne[1]. A [in, rank] -> ne [in, rank]; B [rank, out] -> ne [rank, out].
+                ggml_dims.push_back({shape[0], shape[1]});
+                ++cursor;
+            }
+        }
+    }
+    uint64_t data_off = 0;
+    for (size_t i = 0; i < params.size(); ++i) {
+        gguf_string(out, tensor_names[i]);
+        const uint32_t n_dims = 2;
+        const uint32_t dtype = 1; // F16
+        out.write(reinterpret_cast<const char*>(&n_dims), 4);
+        uint64_t d0 = static_cast<uint64_t>(ggml_dims[i].first);
+        uint64_t d1 = static_cast<uint64_t>(ggml_dims[i].second);
+        out.write(reinterpret_cast<const char*>(&d0), 8);
+        out.write(reinterpret_cast<const char*>(&d1), 8);
+        out.write(reinterpret_cast<const char*>(&dtype), 4);
+        out.write(reinterpret_cast<const char*>(&data_off), 8);
+        const uint64_t nbytes = static_cast<uint64_t>(params[i]->numel()) * 2;
+        data_off += (nbytes + alignment - 1) & ~(alignment - 1);
+    }
+    const auto header_end = static_cast<uint64_t>(out.tellp());
+    const uint64_t padded = (header_end + alignment - 1) & ~(alignment - 1);
+    for (uint64_t i = header_end; i < padded; ++i) {
+        const char z = 0;
+        out.write(&z, 1);
+    }
+    for (const auto& param : params) {
+        const float* src = param->data<float>();
+        const int64_t rows = param->shape()[0];
+        const int64_t cols = param->shape()[1];
+        // ggml ne[0]=rows, ne[1]=cols is laid out as cols rows of `rows` values: the transpose.
+        std::vector<uint16_t> packed(static_cast<size_t>(rows * cols));
+        for (int64_t c = 0; c < cols; ++c) {
+            for (int64_t r = 0; r < rows; ++r) {
+                packed[static_cast<size_t>(c * rows + r)] = f32_to_f16(src[r * cols + c]);
+            }
+        }
+        out.write(reinterpret_cast<const char*>(packed.data()), static_cast<std::streamsize>(packed.size() * 2));
+        const uint64_t nbytes = packed.size() * 2;
+        const uint64_t pad = ((nbytes + alignment - 1) & ~(alignment - 1)) - nbytes;
+        for (uint64_t i = 0; i < pad; ++i) {
+            const char z = 0;
+            out.write(&z, 1);
+        }
+    }
+}
