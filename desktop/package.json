{
  "name": "lora-bge-memory",
  "version": "0.2.24",
  "private": true,
  "description": "萤语 Yingyu 桌面客户端",
  "author": "LoRA-bge-long-memory",
  "homepage": "https://github.com/kingshuoxu/LoRA-bge-long-memory",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.lorabge.memory",
    "productName": "Yingyu",
    "executableName": "lora-bge-memory",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "update-plan.js",
      "download-file.js",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kingshuoxu",
        "repo": "LoRA-bge-long-memory",
        "releaseType": "prerelease"
      }
    ],
    "extraResources": [
      {
        "from": "../packaging/runtime",
        "to": "runtime"
      },
      {
        "from": "../memory_core",
        "to": "app/memory_core",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../backend",
        "to": "app/backend",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../scripts",
        "to": "app/scripts",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "../packaging/e2e-check.sh",
        "to": "e2e-check.sh"
      },
      {
        "from": "../packaging/e2e-check.cmd",
        "to": "e2e-check.cmd"
      }
    ],
    "artifactName": "Yingyu-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "LoRA-bge-long-memory",
      "synopsis": "萤语，本地长记忆对话",
      "description": "本地多轮对话。说下想记住的事，巩固之后会在以后的对话里想起。",
      "desktop": {
        "Name": "萤语",
        "Comment": "Yingyu，本地长记忆对话",
        "Categories": "Utility;"
      }
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "shortcutName": "萤语"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "notarize": false
    },
    "dmg": {
      "title": "萤语"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
